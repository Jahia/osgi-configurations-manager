{
    "compilerOptions": {
        "outDir": "./target/javascript/",
        "sourceMap": true,
        "module": "esnext",
        "target": "es5",
        "jsx": "react",
        "lib": [
            "es6",
            "dom"
        ],
        "moduleResolution": "node",
        // TypeScript 6 deprecates moduleResolution=node10 (what "node" maps to) and
        // target=es5, and errors on them unless this is set. Both are kept deliberately:
        // raising the target would change the emitted bundle and the browser baseline the
        // module ships against, which is a separate, deliberate decision. Revisit before
        // TypeScript 7, where the options stop functioning altogether.
        "ignoreDeprecations": "6.0",
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "noUnusedLocals": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "allowJs": true
    },
    // With allowJs and no "include", every .js under the project joins the program ts-loader
    // type-checks, including the previous build's output. Since Monaco 0.56 that output holds
    // the TypeScript compiler (its ts.worker), and checking it overflowed the stack, so a second
    // `yarn build` failed until the output was deleted. "node" is the toolchain Maven installs.
    "exclude": [
        "src/main/resources/javascript/apps",
        "node",
        "node_modules",
        "tests",
        "target",
        "dist"
    ]
}
